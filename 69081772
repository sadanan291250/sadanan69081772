  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --pink: #d9829b;
      --dark-pink: #a95d78;
      --cream: #fff8ef;
      --soft-cream: #fff1e5;
      --brown: #6f4b3e;
      --text: #5d4a43;
      --white: #ffffff;
      --line: #efd9cf;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Segoe UI", Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--cream);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    ul {
      list-style: none;
    }

    header {
      background: rgba(255, 248, 239, 0.97);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(111, 75, 62, 0.06);
    }

    .navbar {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-mark {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--pink);
      display: grid;
      place-items: center;
      font-size: 25px;
      border: 3px solid #f3c3cf;
      overflow: hidden;
      padding: 0;
    }

    .logo-mark img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .logo-text {
      color: var(--brown);
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .logo-text span {
      color: var(--pink);
    }

    .nav-links {
      display: flex;
      gap: 6px;
    }

    .nav-links li a {
      color: var(--brown);
      padding: 9px 13px;
      border-radius: 20px;
      font-size: 14px;
      transition: 0.2s ease;
    }

    .nav-links li a:hover,
    .nav-links li a.active {
      background: var(--pink);
      color: var(--white);
    }

    .menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
    }

    .menu-toggle span {
      width: 26px;
      height: 3px;
      background: var(--brown);
      border-radius: 2px;
    }

    .hero {
      background: linear-gradient(135deg, #fff8ef 0%, #f8dbe2 100%);
      padding: 72px 20px;
      overflow: hidden;
    }

    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 55px;
      flex-wrap: wrap;
    }

    .hero-text {
      flex: 1 1 430px;
    }

    .eyebrow {
      color: var(--dark-pink);
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 10px;
      font-size: 13px;
    }

    .hero-text h1 {
      font-size: 48px;
      margin-bottom: 16px;
      line-height: 1.15;
      color: var(--brown);
    }

    .hero-text h1 span {
      color: var(--pink);
    }

    .hero-text p {
      font-size: 17px;
      color: #765f56;
      margin-bottom: 26px;
      max-width: 540px;
    }

    .hero-image {
      flex: 1 1 350px;
      text-align: center;
    }

    .hero-doll {
      width: min(390px, 100%);
      min-height: 420px;
      margin: auto;
      border-radius: 45% 45% 35% 35%;
      background: #f4c8d3;
      border: 8px solid #fff;
      box-shadow: 0 18px 40px rgba(111, 75, 62, 0.16);
      padding: 14px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-photo {
      width: 100%;
      max-width: 520px;
      border-radius: 24px;
      display: block;
      object-fit: cover;
      box-shadow: 0 18px 40px rgba(169, 93, 120, 0.16);
    }

    .btn {
      display: inline-block;
      padding: 12px 25px;
      border-radius: 25px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      border: none;
      transition: 0.2s ease;
    }

    .btn-primary {
      background: var(--pink);
      color: var(--white);
    }

    .btn-outline {
      background: var(--white);
      color: var(--dark-pink);
      border: 2px solid var(--pink);
      margin-left: 10px;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 7px 16px rgba(111, 75, 62, 0.15);
    }

